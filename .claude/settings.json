{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "node .claude/skills/pr-self-review/scripts/pr-guard.mjs",
            "timeout": 20,
            "statusMessage": "Перевіряю self-review перед PR…"
          }
        ]
      }
    ]
  }
}
