--- /dev/null
+++ b/server/src/modules/digests/helpers.ts
@@ -0,0 +1,12 @@
+import * as t from '../../db/schema.js';
+
+/** Format a digest row for the API. */
+export function toDigestDto(row: typeof t.digests.$inferSelect) {
+  return {
+    id: row.id,
+    created_at: row.createdAt.toISOString(),
+    total_runs: row.totalRuns,
+  };
+}
