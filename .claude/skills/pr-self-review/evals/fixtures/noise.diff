index 0000000..1a2b3c4
--- /dev/null
+++ b/client/src/components/run-cost-badge/RunCostBadge.tsx
@@ -0,0 +1,18 @@
+'use client';
+
+import { useMemo } from 'react';
+
+export function RunCostBadge({ cents }: { cents: number }) {
+  // useMemo over a single division buys nothing
+  const label = useMemo(() => `$${(cents / 100).toFixed(2)}`, [cents]);
+
+  return (
+    <span className="rounded bg-slate-100 px-2 py-0.5 text-xs" title="Cost of this run">
+      {label}
+    </span>
+  );
+}
