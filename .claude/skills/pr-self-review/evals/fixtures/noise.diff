     queryFn: () => api.get(`/repos/${repoId}/reviews`),
   });
 }
+
+export function useRunCosts(repoId: string, pullNumber: number) {
+  return useQuery({
+    queryKey: ['run-costs', repoId, pullNumber],
+    queryFn: () => api.get(`/repos/${repoId}/pulls/${pullNumber}/runs`),
+  });
+}
